VITE_SUPABASE_URL=https://znwgqdaqxxynxoltuhpp.supabase.co
VITE_SUPABASE_ANON_KEY=

# Leave blank for the local demo mode. The browser must never receive a
# Supabase service-role key or a payment-provider secret.
VITE_APP_ENV=development

# Backend-only PayOS secrets. Set these with Supabase CLI secrets, never in
# VITE_* variables and never expose them to the browser:
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_API_BASE_URL=https://api-merchant.payos.vn
# PAYOS_RETURN_URL=http://127.0.0.1:5173/checkout
# PAYOS_CANCEL_URL=http://127.0.0.1:5173/checkout

# Backend-only secret for the scheduled order-expiry function:
# ORDER_EXPIRY_SECRET=
