{
  "name": "dop-mart-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:encoding",
    "build": "vite build",
    "preview": "vite preview",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,js,vue}\" \"storefront-ui/**/*.{html,css,js}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.{js,mjs}\" \"index.html\" \"ProductListing.html\" \"vite.config.js\" \"postcss.config.js\" \"tailwind.config.cjs\" \"tsconfig.json\" \"prisma.config.ts\" \"components.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,js,vue}\" \"storefront-ui/**/*.{html,css,js}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.{js,mjs}\" \"index.html\" \"ProductListing.html\" \"vite.config.js\" \"postcss.config.js\" \"tailwind.config.cjs\" \"tsconfig.json\" \"prisma.config.ts\" \"components.json\"",
    "test:mart": "node --test tests/mart-contract.test.mjs",
    "utf8": "node scripts/utf8.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@lucide/vue": "^1.72.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.119.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gsap": "3.12.5",
    "lucide-vue-next": "0.468.0",
    "motion-v": "^2.11.1",
    "pinia": "2.3.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@allanyiin/frontend-design": "^2026.8.15",
    "@its-thepoe/design-motion-principles": "^1.0.1",
    "@superdesign/cli": "^0.14.0",
    "@vitejs/plugin-vue": "5.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^8.0.0-rc.34",
    "supabase": "^3.3.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
